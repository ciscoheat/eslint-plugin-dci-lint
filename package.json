{
  "name": "eslint-plugin-dci-lint",
  "version": "0.9.1",
  "author": "Andreas Söderlund <ciscoheat@gmail.com> (https://blog.encodeart.dev)",
  "description": "A Typescript ESLint plugin that helps you adhere to DCI conventions.",
  "repository": {
    "url": "https://github.com/ciscoheat/eslint-plugin-dci-lint"
  },
  "homepage": "https://blog.encodeart.dev/series/dci-typescript-tutorial",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "typescript",
    "dci"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": "./lib/index.js",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc && npm run test",
    "dev": "tsc-watch --onSuccess \"pnpm lint\"",
    "lint": "eslint .",
    "test": "node tests/tests.mjs"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@tsconfig/node18": "^18.2.7",
    "@types/debug": "^4.1.13",
    "@types/esquery": "^1.5.4",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.1",
    "@typescript-eslint/utils": "^8.68.0",
    "debug": "^4.4.3",
    "eslint": "^9.39.5",
    "eslint-plugin-eslint-plugin": "^6.5.0",
    "eslint-plugin-node": "^11.1.0",
    "esquery": "^1.7.0",
    "fs-extra": "^11.4.0",
    "globals": "^15.15.0",
    "mocha": "^11.8.0",
    "tsc-watch": "^6.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": "^14.17.0 || ^16.0.0 || >= 18.0.0"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "typescript": ">=5.0.0 <7.0.0"
  },
  "license": "MIT"
}
